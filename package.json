{
  "name": "@gdbots/pbjx",
  "version": "3.1.0",
  "description": "Pbj messaging tools for es6.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdbots/pbjx-js.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run clean && npm run lint && npm run test && npm run build:babel && npm run build:prepub",
    "build:babel": "babel src --out-dir ./dist",
    "build:prepub": "cp -rf ./{*.md,package.json} ./dist",
    "clean": "rimraf ./dist",
    "lint": "echo 'lgtm'",
    "pub": "npm run build && cd dist && npm publish --access public",
    "test": "tape -r ./tests/bootstrap.cjs './tests/**/*.test.js*' | faucet"
  },
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "jws": "^4.0.1",
    "urijs": "^1.19.10"
  },
  "peerDependencies": {
    "@gdbots/schemas": "^3.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.6",
    "@babel/register": "^8.0.5",
    "@gdbots/acme-schemas": "^3.1.0",
    "@gdbots/pbj": "^4.0.0",
    "faucet": "^0.0.4",
    "isomorphic-fetch": "^3.0.0",
    "lodash-es": "^4.17.15",
    "md5": "^2.3.0",
    "rimraf": "^6.1.3",
    "tape-es": "^1.2.17",
    "utf8": "^3.0.0",
    "uuid": "^14.0.3"
  }
}
